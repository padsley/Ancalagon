# Scene setup, run after the viewer is opened (see init_vis.mac).

/vis/viewer/set/autoRefresh false
/vis/viewer/set/style wireframe
/vis/viewer/set/lineSegmentsPerCircle 48

/vis/drawVolume

# The chain spans roughly x in [-1050,50]cm, z in [-150,700]cm (see
# README) -- looking mostly down the Y axis and zooming well out shows
# the whole beamline in one view.
/vis/viewer/set/viewpointVector 0 1 0.3
/vis/viewer/set/upVector 0 0 1
/vis/viewer/zoomTo 0.3

/vis/scene/add/axes 0 0 0 100 cm
/vis/scene/add/trajectories smooth
/vis/modeling/trajectories/create/drawByCharge
/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
/vis/scene/endOfEventAction accumulate

/vis/viewer/set/autoRefresh true
/vis/viewer/flush
